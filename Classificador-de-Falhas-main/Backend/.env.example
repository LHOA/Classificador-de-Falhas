# Banco de dados (qualquer URL SQLAlchemy). Padrão: SQLite local.
DATABASE_URL=sqlite:///./failuremap.db
# Exemplo com PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/failuremap

# Origens permitidas para CORS (separadas por vírgula) ou * para todas
ALLOWED_ORIGINS=*

# Limite de requisições por minuto e por IP nas rotas de inferência e escrita.
# Use 0 para desativar (não recomendado em instância pública).
RATE_LIMIT_PER_MIN=60
